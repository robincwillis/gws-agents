# Copy to .env (at the repo root) and fill in your values.
# Never commit the real .env — it is gitignored.

# ── Gemini / Google AI ─────────────────────────────────────────────────────
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Set to 1 to use Vertex AI instead of the public Gemini API.
# When 1, GOOGLE_API_KEY is ignored and Application Default Credentials
# (gcloud auth application-default login) are used.
GOOGLE_GENAI_USE_VERTEXAI=0

# ── Slack gateway (optional) ───────────────────────────────────────────────
# Only needed if running slack_gateway.py to bridge Slack DMs/@mentions
# into the ADK api_server. Setup walkthrough is in slack_gateway.py.
#
# Bot User OAuth Token (xoxb-...) — from OAuth & Permissions
SLACK_BOT_TOKEN=
# App-Level Token (xapp-...) with connections:write scope — from Socket Mode
SLACK_APP_TOKEN=

# Override if the ADK api_server runs somewhere other than the default.
# ADK_BASE_URL=http://127.0.0.1:8000
